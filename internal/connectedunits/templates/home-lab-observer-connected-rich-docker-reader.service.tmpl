[Unit]
Description=Home Lab Observer isolated read-only Docker sampler
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
User={{.ReaderUID}}
Group={{.FrameGID}}
SupplementaryGroups={{.SocketGID}}
RootDirectory=/var/lib/home-lab-observer-connected-rich/reader-root
MountAPIVFS=no
ExecStart=/bin/observer-connected-rich-docker-reader
WorkingDirectory=/
UMask=0077
StandardInput=null
StandardOutput=null
StandardError=null
Environment=GODEBUG=netdns=go
Environment=GOMAXPROCS=2
Environment=GOMEMLIMIT=64MiB
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateIPC=yes
ProtectSystem=strict
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @module @raw-io @reboot @swap @ipc ptrace process_vm_readv process_vm_writev kcmp perf_event_open bpf userfaultfd socketpair io_uring_setup io_uring_enter io_uring_register mknod mknodat
SystemCallErrorNumber=EPERM
NoExecPaths=/
ExecPaths=/bin/observer-connected-rich-docker-reader
BindReadOnlyPaths=/opt/home-lab-observer-connected-rich/releases/{{.ArtifactSHA256}}/observer-connected-rich-docker-reader:/bin/observer-connected-rich-docker-reader
BindReadOnlyPaths=/etc/home-lab-observer-connected-rich/installed.json:/etc/home-lab-observer-connected-rich/installed.json
BindReadOnlyPaths=/etc/home-lab-observer-connected-rich/collection-policy.json:/etc/home-lab-observer-connected-rich/collection-policy.json
BindReadOnlyPaths=/run/docker.sock:/engine/docker.sock
BindReadOnlyPaths=/run/home-lab-observer-connected-rich/reader-activation:/activation
BindPaths=/var/lib/home-lab-observer-connected-rich/docker-frame:/frame /var/lib/home-lab-observer-connected-rich/reader-status:/state/status
ReadWritePaths=/frame /state/status
LimitCORE=0
MemoryMax=128M
MemoryPressureWatch=skip
TasksMax=32
CPUQuota=25%
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes
Restart=no
FileDescriptorStoreMax=0

[Install]
WantedBy=multi-user.target
