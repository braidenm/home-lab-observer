Type=exec
User={{.UploaderUID}}
Group={{.UploaderGID}}
SupplementaryGroups={{.SharedGID}}
RootDirectory=/var/lib/home-lab-observer-connected/uploader-root
MountAPIVFS=no
WorkingDirectory=/
UMask=0077
Environment=GODEBUG=netdns=go
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateIPC=yes
PrivateNetwork={{.PrivateNetwork}}
ProtectSystem=strict
DevicePolicy=closed
RestrictAddressFamilies={{.AddressFamilies}}
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @module @raw-io @reboot @swap @ipc ptrace process_vm_readv process_vm_writev kcmp perf_event_open bpf userfaultfd socketpair io_uring_setup io_uring_enter io_uring_register mknod mknodat
SystemCallErrorNumber=EPERM
NoExecPaths=/
ExecPaths=/bin/observer-connected-uploader
BindReadOnlyPaths=/opt/home-lab-observer-connected/releases/{{.ArtifactSHA256}}/observer-connected-uploader:/bin/observer-connected-uploader
BindPaths={{.StateBind}}
ReadWritePaths={{.StateWrite}}
IPAddressDeny=any
{{.AddressRules}}LimitCORE=0
MemoryMax=128M
TasksMax=64
RuntimeMaxSec=45s
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes
Restart=no
