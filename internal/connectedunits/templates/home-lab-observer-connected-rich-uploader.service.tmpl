[Unit]
Description=Home Lab Observer connected rich process uploader
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
User={{.UploaderUID}}
Group={{.UploaderGID}}
SupplementaryGroups={{.SharedGID}}
RootDirectory=/var/lib/home-lab-observer-connected-rich/uploader-root
MountAPIVFS=no
ExecStart=/bin/observer-connected-rich-uploader
WorkingDirectory=/
UMask=0077
StandardInput=null
StandardOutput=null
StandardError=null
Environment=GODEBUG=netdns=go
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateIPC=yes
ProtectSystem=strict
DevicePolicy=closed
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @module @raw-io @reboot @swap @ipc ptrace process_vm_readv process_vm_writev kcmp perf_event_open bpf userfaultfd socketpair io_uring_setup io_uring_enter io_uring_register mknod mknodat
SystemCallErrorNumber=EPERM
NoExecPaths=/
ExecPaths=/bin/observer-connected-rich-uploader
BindReadOnlyPaths=/opt/home-lab-observer-connected-rich/releases/{{.ArtifactSHA256}}/observer-connected-rich-uploader:/bin/observer-connected-rich-uploader
BindReadOnlyPaths=/etc/home-lab-observer-connected-rich/installed.json:/etc/home-lab-observer-connected-rich/installed.json
BindReadOnlyPaths=/etc/home-lab-observer-connected-rich/collection-policy.json:/etc/home-lab-observer-connected-rich/collection-policy.json
BindReadOnlyPaths=/var/lib/home-lab-observer-connected-rich/handoff:/handoff
BindReadOnlyPaths=/run/home-lab-observer-connected-rich/activation:/activation
BindPaths=/var/lib/home-lab-observer-connected-rich/ledger:/state/ledger /var/lib/home-lab-observer-connected-rich/uploader-status:/state/status
ReadWritePaths=/state/ledger /state/status
LoadCredential=connector.json:/etc/home-lab-observer-connected-rich/credentials/connector.json
IPAddressDeny=any
{{.AddressRules}}LimitCORE=0
MemoryMax=256M
MemoryPressureWatch=skip
TasksMax=64
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes
Restart=no
FileDescriptorStoreMax=0

[Install]
WantedBy=multi-user.target
