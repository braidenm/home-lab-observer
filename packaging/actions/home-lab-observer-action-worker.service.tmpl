[Unit]
Description=Home Lab Observer Docker action worker
Requires=home-lab-observer-action-broker.service
After=home-lab-observer-action-broker.service

[Service]
Type=exec
WorkingDirectory=/
UMask=0077
StandardInput=null
StandardOutput=null
StandardError=null
Environment=GODEBUG=netdns=go
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=no
PrivateIPC=yes
ProtectSystem=strict
DevicePolicy=closed
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @module @raw-io @reboot @swap ptrace process_vm_readv process_vm_writev kcmp perf_event_open bpf userfaultfd io_uring_setup io_uring_enter io_uring_register mknod mknodat
SystemCallErrorNumber=EPERM
LimitCORE=0
MemoryMax=256M
TasksMax=64
CPUQuota=50%
KillMode=control-group
Restart=no
FileDescriptorStoreMax=0
MountAPIVFS=no
NoExecPaths=/
User=home-lab-observer-action-worker
Group=home-lab-observer-action-worker
SupplementaryGroups=home-lab-observer-action-ipc
RootDirectory=/var/lib/home-lab-observer-actions/worker-root
ExecStart=/bin/observer-action-worker
ExecPaths=/bin/observer-action-worker
TimeoutStopSec=10s
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=@WORKER_EGRESS@
BindReadOnlyPaths=/opt/home-lab-observer-actions/releases/@MANIFEST_SHA256@/observer-action-worker:/bin/observer-action-worker
BindReadOnlyPaths=/proc:/proc:norbind
BindReadOnlyPaths=/etc/passwd /etc/group /etc/nsswitch.conf
BindReadOnlyPaths=/etc/home-lab-observer-actions/worker-hosts:/etc/hosts
BindReadOnlyPaths=/run/home-lab-observer-actions/host-userns
BindReadOnlyPaths=/etc/home-lab-observer-actions/worker.json
BindReadOnlyPaths=/run/home-lab-observer-actions/worker
BindReadOnlyPaths=/etc/ssl/certs/ca-certificates.crt
BindPaths=/var/lib/home-lab-observer-actions/worker
ReadWritePaths=/var/lib/home-lab-observer-actions/worker
